# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/satquery_db
REDIS_URL=redis://localhost:6379/0

# Models Path
MODELS_PATH=./models
DATA_PATH=./data

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Settings
VQA_MODEL=blip-vqa-base
GROUNDING_MODEL=groundingdino
SAR_MODEL=sentinel1-classifier
CHANGE_DETECTION_MODEL=siamese-net

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=llama-3.2-11b-vision-preview

# Hugging Face Configuration
HF_TOKEN=your_hugging_face_token_here
HF_VQA_MODEL=Salesforce/blip-vqa-base
HF_GROUNDING_MODEL=facebook/detr-resnet-50
HF_FEATURE_MODEL=google/vit-base-patch16-224

# Roboflow Configuration
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_PUBLISHABLE_KEY=your_publishable_key_here
ROBOFLOW_WORKSPACE=sahil-khaire
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-2
ROBOFLOW_CLASSES=Building

# Roboflow Water Body Detection Configuration
ROBOFLOW_WATERBODY_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WATERBODY_WORKSPACE=sahil-khaire
ROBOFLOW_WATERBODY_WORKFLOW_ID=general-segmentation-api-4
ROBOFLOW_WATERBODY_CLASSES=Water

# Detection Configuration
BUILDING_CONFIDENCE_THRESHOLD=0.4
WATERBODY_CONFIDENCE_THRESHOLD=0.4
WATERBODY_MIN_AREA=100
NDVI_THRESHOLD=0.3
NDWI_THRESHOLD=0.2
BUILDING_MIN_AREA=100

# Processing
MAX_IMAGE_SIZE=1024
BATCH_SIZE=4
CONFIDENCE_THRESHOLD=0.7
