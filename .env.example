# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/satquery_db
REDIS_URL=redis://localhost:6379/0

# Models Path
MODELS_PATH=./models
DATA_PATH=./data

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model Settings
VQA_MODEL=blip-vqa-base
GROUNDING_MODEL=groundingdino
SAR_MODEL=sentinel1-classifier
CHANGE_DETECTION_MODEL=siamese-net

# Processing
MAX_IMAGE_SIZE=1024
BATCH_SIZE=4
CONFIDENCE_THRESHOLD=0.7
